{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.+\\.m3u8?)$",
      "dest": "/$1",
      "headers": {
        "Content-Type": "application/x-mpegURL"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
